NODE_ENV=development
PORT=4000
PUBLIC_APP_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/discover_mahdia
JWT_SECRET=change-this-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
# Prefer ADMIN_PASSWORD_HASH in production. Generate with bcrypt.
# ADMIN_PASSWORD_HASH=$2a$12$...
GAME_DURATION_SECONDS=3600
BASE_DISCOVERY_POINTS=100
SPEED_BONUS_POINTS=40
SPEED_BONUS_SECONDS=180
COMBO_BONUS_POINTS=15
PERFECT_STREAK_POINTS=60
WRONG_SCAN_PENALTY=20
